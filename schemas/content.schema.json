{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearnMatch AI content pack",
  "type": "array",
  "minItems": 10,
  "items": {
    "type": "object",
    "required": ["id", "title", "image", "field", "color", "description", "facts", "source", "imageCredit", "imageLicense"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "title": {
        "type": "object",
        "required": ["th", "en"],
        "properties": { "th": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } },
        "additionalProperties": false
      },
      "image": { "type": "string", "pattern": "^/assets/.+" },
      "field": {
        "type": "object",
        "required": ["th", "en"],
        "properties": { "th": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } },
        "additionalProperties": false
      },
      "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
      "description": {
        "type": "object",
        "required": ["th", "en"],
        "properties": { "th": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } },
        "additionalProperties": false
      },
      "facts": {
        "type": "object",
        "required": ["th", "en"],
        "properties": {
          "th": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "en": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      },
      "source": {
        "type": "object",
        "required": ["url", "language", "label"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "language": { "enum": ["th", "en"] },
          "label": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "imageCredit": { "type": "string", "minLength": 1 },
      "imageLicense": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": false
  }
}
